# Supabase (public anon key — safe for client-side, RLS protects data)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry crash reporting (get DSN from https://sentry.io)
EXPO_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# RevenueCat (get API key from https://app.revenuecat.com → Project → API Keys)
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_your_api_key

# Meta / Facebook SDK (get from https://developers.facebook.com → My Apps → Settings → Basic)
EXPO_PUBLIC_FACEBOOK_APP_ID=000000000000000
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=your_client_token
EXPO_PUBLIC_FACEBOOK_DISPLAY_NAME=BreathFlow
