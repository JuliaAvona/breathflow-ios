@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context — WalkPace

Person(walker, "Walker", "Person doing Japanese Interval Walking Training")

System(walkpace, "WalkPace", "Mobile app for interval walking timer with coaching, badges, and progress tracking")

System_Ext(supabase, "Supabase", "Auth + PostgreSQL cloud backend with RLS")
System_Ext(healthkit, "Apple HealthKit", "Health data API on iOS")
System_Ext(sentry, "Sentry", "Crash reporting and error monitoring")
System_Ext(appleauth, "Apple ID", "Sign in with Apple identity provider")

Rel(walker, walkpace, "Uses daily", "iOS app")
Rel(walkpace, supabase, "Auth, sync data", "HTTPS / REST")
Rel(walkpace, healthkit, "Writes workout sessions", "HealthKit API")
Rel(walkpace, sentry, "Reports crashes", "HTTPS")
Rel(walkpace, appleauth, "Authenticates", "OAuth / ID Token")

SHOW_LEGEND()
@enduml
